# Copy to backend/.env for local development. In production these are set in
# the Vercel project (Settings -> Environment Variables), never committed.

# Postgres in production. Paste the URL your provider gives you as-is
# (postgres://, postgresql:// and postgresql+psycopg:// all work).
# Leave unset locally to use a SQLite file.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs login tokens. Production refuses to serve without a random value of
# 32+ characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# "production" turns on the safety checks above. On Vercel it is inferred.
# ENVIRONMENT=production

# Create the demo accounts (password coach1234) when the database is empty.
SEED_DEMO_DATA=true

# AI provider: "heuristic" (no network, deterministic, free) or "anthropic"
AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Password-reset emails, sent through Resend (resend.com, free tier). Without
# a key, "Forgot password?" answers normally but sends nothing.
RESEND_API_KEY=
# EMAIL_FROM=Research Coach <no-reply@researchcoach.app>
# Links in emails use SITE_URL, or VITE_SITE_URL when SITE_URL is unset.
# SITE_URL=https://www.researchcoach.app

# Only needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=http://localhost:5173

# Failed sign-ins / sign-ups / join-code guesses allowed per 5 minutes
# (per account; 5x that per network address, for shared school Wi-Fi).
AUTH_RATE_LIMIT=10
