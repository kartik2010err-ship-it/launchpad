# Postgres in production / docker-compose. Falls back to SQLite when unset.
DATABASE_URL=postgresql+psycopg://research:research@localhost:5432/research_coach
SECRET_KEY=change-me-in-production
# AI provider: "heuristic" (no network, deterministic) or "anthropic"
AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Comma-separated origins for CORS
CORS_ORIGINS=http://localhost:5173
